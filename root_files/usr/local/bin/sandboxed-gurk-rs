#!/bin/bash
set -euxo pipefail

exec bwrap \
	--unshare-all \
	--share-net \
	--die-with-parent \
	--new-session \
	--proc /proc \
	--dev /dev \
	--ro-bind /usr/bin/gurk /usr/bin/gurk \
	--ro-bind /usr/lib /usr/lib \
	--ro-bind /usr/local/lib /usr/local/lib \
	--ro-bind /lib /lib  \
	--ro-bind /lib64 /lib64 \
	--ro-bind /etc/ld.so.preload /etc/ld.so.preload \
	--ro-bind /etc/ssl /etc/ssl \
	--ro-bind /etc/ca-certificates /etc/ca-certificates \
	--ro-bind /usr/share/zoneinfo /usr/share/zoneinfo \
	--ro-bind /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime \
	--dir /run/user/$(id -u) \
	--bind $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY /run/user/$(id -u)/$WAYLAND_DISPLAY \
	--setenv XDG_RUNTIME_DIR /run/user/$(id -u) \
	--setenv LD_PRELOAD /usr/lib/libhardened_malloc.so \
	--setenv WAYLAND_DISPLAY $WAYLAND_DISPLAY \
	--tmpfs /tmp \
	--ro-bind /home/${USER}/.config/gurk /home/${USER}/.config/gurk \
	--bind /home/${USER}/.local/share/gurk /home/${USER}/.local/share/gurk \
	/usr/bin/gurk
