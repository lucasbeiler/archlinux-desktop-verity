#!/bin/sh
# update.sh
# Performs an A/B update from the latest GitHub Release.
# Usage: sudo sh update.sh
set -euo pipefail

RELEASE_TAG="$(curl -sL https://api.github.com/repos/lucasbeiler/archlinux-desktop-verity/releases | grep -oE 'os-[0-9]{12}' | sort | tail -n1 | tr -d 'os-')"
RELEASE_URL="https://github.com/lucasbeiler/archlinux-desktop-verity/releases/download/${RELEASE_TAG}"
WORKDIR="$(mktemp -d)"

# Helpers
info() { echo -e "\e[1;32m[INFO]\e[0m  $*"; }
die()  { echo -e "\e[1;31m[ERR]\e[0m   $*" >&2; exit 1; }

lsblk -o LABEL -n | grep -qx "$RELEASE_TAG" && exit 0 || info "Preparing..."
[[ $EUID -eq 0 ]] || die "Run as root."

command -v xdelta3 >/dev/null || die "xdelta3 not found"
command -v veritysetup >/dev/null || die "veritysetup not found"

findmnt -T "${WORKDIR}" -n -o FSTYPE | grep -qx tmpfs || die "Using a tmpfs for ${WORKDIR} is recommended."

trap 'rm -rf "$WORKDIR"' EXIT INT TERM

info "Downloading artifacts (build ${RELEASE_TAG})..."

CURRENT_ROOT="/dev/$(ls /sys/class/block/dm-0/slaves/ | awk '{ print $1 }' | sort | head -1)" || die "Cannot detect current partition."
[ -b "$CURRENT_ROOT" ] || die "$CURRENT_ROOT is not a block device."
DISK=$(echo "$CURRENT_ROOT" | sed 's/[0-9]*$//')
CURRENT_TAG="$(lsblk -o LABEL,MOUNTPOINT -nr | awk '$2=="/" {print $1}' | sort | uniq)"
[ -n "$CURRENT_TAG" ] || die "Could not determine current build tag from mounted root label."
[ "$CURRENT_TAG" = "$RELEASE_TAG" ] && { info "Already up to date ($CURRENT_TAG)."; exit 0; }
DELTA_NAME="rootfs-${CURRENT_TAG}-to-${RELEASE_TAG}.xdelta"

if curl -L -f --progress-bar -o "$WORKDIR/rootfs.delta" "$RELEASE_URL/$DELTA_NAME" 2>/dev/null; then
  info "Reconstructing rootfs.erofs from delta against current slot..."
  xdelta3 -d -s "$CURRENT_ROOT" "$WORKDIR/rootfs.delta" "$WORKDIR/rootfs.erofs" || die "Delta reconstruction failed"
else
  curl -L -f --progress-bar -o "$WORKDIR/rootfs.erofs" "$RELEASE_URL/rootfs.erofs" || die "Failed rootfs download"
fi

curl -L -f --progress-bar -o "$WORKDIR/bootloader-signed.efi" "$RELEASE_URL/bootloader-signed.efi" || die "Failed bootloader download"
curl -L -f --progress-bar -o "$WORKDIR/uki-${RELEASE_TAG}-signed.efi" "$RELEASE_URL/uki-${RELEASE_TAG}-signed.efi" || die "Failed UKI download"
curl -L -f --progress-bar -o "$WORKDIR/rootfs.erofs.verity" "$RELEASE_URL/rootfs.erofs.verity" || die "Failed verity download"
curl -L -f --progress-bar -o "$WORKDIR/SHA256SUMS" "$RELEASE_URL/SHA256SUMS-${RELEASE_TAG}" || die "Failed SHA256SUMS download"
curl -L -f --progress-bar -o "$WORKDIR/SHA256SUMS.sig" "$RELEASE_URL/SHA256SUMS-${RELEASE_TAG}.sig" || die "Failed SHA256SUMS signature download"

ALLOWED_SIGNERS="$(mktemp)"
echo "build@host $(cat /etc/build_signing_key.pub)" > "$ALLOWED_SIGNERS"
ssh-keygen -Y verify -f "$ALLOWED_SIGNERS" -I build@host -n hardenedos-build -s "$WORKDIR/SHA256SUMS.sig" < "$WORKDIR/SHA256SUMS" || die "Manifest signature verification failed"
rm -f "$ALLOWED_SIGNERS"
info "Manifest signature OK."
(cd "$WORKDIR" && sha256sum --check --ignore-missing SHA256SUMS) || die "Hash verification failed"
info "Artifact hashes OK."

if echo "$CURRENT_ROOT" | grep -q '2$' ; then
  CURRENT_SLOT="a"
  TARGET_ROOT="${DISK}4"
  TARGET_VERITY="${DISK}5"
elif echo "$CURRENT_ROOT" | grep -q '4$'; then
  CURRENT_SLOT="b"
  TARGET_ROOT="${DISK}2"
  TARGET_VERITY="${DISK}3"
else
  die "Cannot determine current slot from ${CURRENT_ROOT}, expected ${DISK}2 or ${DISK}4."
fi

if [ "$CURRENT_SLOT" = "a" ]; then TARGET_SLOT="b"; else TARGET_SLOT="a"; fi

sync
info "Current slot: $CURRENT_SLOT ($CURRENT_ROOT)"
info "Writing to slot: $TARGET_SLOT ($TARGET_ROOT and $TARGET_VERITY)"

before=$(awk '{print $7}' "/sys/class/block/${TARGET_ROOT#/dev/}/stat")

command -v veritysetup >/dev/null || die "veritysetup not found"
ROOTHASH=$(strings "$WORKDIR/uki-${RELEASE_TAG}-signed.efi" | grep -o 'roothash=[^ ]*' | head -n1 | cut -d= -f2)
[ -n "$ROOTHASH" ] || die "Could not extract roothash from UKI"

MAX_ATTEMPTS=3
attempt=1
verified=0
while [ "$attempt" -le "$MAX_ATTEMPTS" ]; do
  info "Write attempt ${attempt}/${MAX_ATTEMPTS}..."

  info "Writing rootfs.erofs to $TARGET_ROOT..."
  dd if="$WORKDIR/rootfs.erofs" of="$TARGET_ROOT" bs=4M oflag=sync || { info "dd rootfs failed on attempt ${attempt}"; attempt=$((attempt + 1)); continue; }
  blockdev --flushbufs "$TARGET_ROOT" 2>/dev/null || true
  udevadm settle
  
  info "Writing rootfs.erofs.verity to $TARGET_VERITY..."
  dd if="$WORKDIR/rootfs.erofs.verity" of="$TARGET_VERITY" bs=4M oflag=sync || { info "dd verity failed on attempt ${attempt}"; attempt=$((attempt + 1)); continue; }
  blockdev --flushbufs "$TARGET_VERITY" 2>/dev/null || true
  udevadm settle

  info "Verifying dm-verity integrity on written partitions..."
  if veritysetup verify "$TARGET_ROOT" "$TARGET_VERITY" "$ROOTHASH"; then
    info "veritysetup verify OK on attempt ${attempt}: written data matches roothash."
    verified=1
    break
  else
    info "veritysetup verify FAILED on attempt ${attempt}."
    attempt=$((attempt + 1))
  fi
done

[ "$verified" -eq 1 ] || die "veritysetup verify failed after ${MAX_ATTEMPTS} attempts, aborting before UUID/ESP update"
after=$(awk '{print $7}' "/sys/class/block/${TARGET_ROOT#/dev/}/stat")
written_sectors=$((after - before))
written_bytes=$((written_sectors * 512))

info "${CURRENT_ROOT}: kernel reports ${written_bytes} bytes written"

# DERIVE PARTUUIDS FROM VERITY ROOT HASH (UAPI DPS)
hex_to_uuid() { local h="$1"; echo "${h:0:8}-${h:8:4}-${h:12:4}-${h:16:4}-${h:20:12}"; }
UUID_ROOT=$(hex_to_uuid "${ROOTHASH:0:32}")
UUID_VERITY=$(hex_to_uuid "${ROOTHASH:32:32}")
info "Updating partition UUIDs for slot $TARGET_SLOT..."
TARGET_ROOT_PARTNUM=$(echo "$TARGET_ROOT" | grep -o '[0-9]*$')
TARGET_VERITY_PARTNUM=$(echo "$TARGET_VERITY" | grep -o '[0-9]*$')
sgdisk --partition-guid="${TARGET_ROOT_PARTNUM}:$UUID_ROOT" $(echo "$TARGET_ROOT" | sed 's/p\?[0-9]*$//') || die "Failed changing root partition UUID"
sgdisk --partition-guid="${TARGET_VERITY_PARTNUM}:$UUID_VERITY" $(echo "$TARGET_VERITY" | sed 's/p\?[0-9]*$//') || die "Failed changing verity partition UUID"
sync

info "Deleting old UKIs..."
KEEP_UKI="uki-${CURRENT_TAG}-signed.efi"
while IFS= read -r old_uki; do
  [ "$old_uki" = "$KEEP_UKI" ] && continue
  mdel -i "${DISK}1" "::/EFI/Linux/$old_uki" || info "Warning: could not delete old UKI: $old_uki"
  info "Deleted old UKI: $old_uki"
done < <(mdir -i "${DISK}1" ::/EFI/Linux/ | awk '/uki-.*-signed\.efi/{print $NF}')

BOOTLOADER_HASH=$(grep -E " \*?bootloader-signed\.efi\$" "$WORKDIR/SHA256SUMS" | awk '{print $1}')
UKI_HASH=$(grep -E " \*?uki-${RELEASE_TAG}-signed\.efi\$" "$WORKDIR/SHA256SUMS" | awk '{print $1}')
[ -n "$BOOTLOADER_HASH" ] || die "No SHA256SUMS entry for bootloader-signed.efi"
[ -n "$UKI_HASH" ] || die "No SHA256SUMS entry for uki-${RELEASE_TAG}-signed.efi"

MAX_ESP_ATTEMPTS=10
attempt=1
esp_ok=0
while [ "$attempt" -le "$MAX_ESP_ATTEMPTS" ]; do
  info "ESP write attempt ${attempt}/${MAX_ESP_ATTEMPTS}..."

  mcopy -oi "${DISK}1" "$WORKDIR/bootloader-signed.efi" ::/EFI/systemd/systemd-bootx64.efi \
    && mcopy -oi "${DISK}1" "$WORKDIR/bootloader-signed.efi" ::/EFI/BOOT/BOOTX64.EFI \
    && mcopy -oi "${DISK}1" "$WORKDIR/uki-${RELEASE_TAG}-signed.efi" ::/EFI/Linux/uki-${RELEASE_TAG}-signed.efi \
    || { info "mcopy failed on attempt ${attempt}"; attempt=$((attempt + 1)); continue; }
  sync
  
  if [ "$(mtype -i "${DISK}1" ::/EFI/systemd/systemd-bootx64.efi | sha256sum | awk '{print $1}')" = "$BOOTLOADER_HASH" ] \
    && [ "$(mtype -i "${DISK}1" ::/EFI/BOOT/BOOTX64.EFI | sha256sum | awk '{print $1}')" = "$BOOTLOADER_HASH" ] \
    && [ "$(mtype -i "${DISK}1" ::/EFI/Linux/uki-${RELEASE_TAG}-signed.efi | sha256sum | awk '{print $1}')" = "$UKI_HASH" ]; then
    esp_ok=1
    break
  fi

  info "ESP verification failed on attempt ${attempt}"
  attempt=$((attempt + 1))
done

[ "$esp_ok" -eq 1 ] || die "Failed writing/verifying ESP files after ${MAX_ESP_ATTEMPTS} attempts"

info "All ESP writes verified."
info "Update complete."
